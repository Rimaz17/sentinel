# Copy to .env at the repository root, then change the password there:
#   cp infra/.env.example .env
# .env is gitignored; this file holds dummy values only.

# Local PostgreSQL started by infra/docker-compose.yml.
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me

# Host port for that database. 5433 avoids clashing with a PostgreSQL already
# installed on the default 5432.
SENTINEL_DB_PORT=5433

# The database connection, used by the Spring Boot API and by the detector.
# Must agree with the values above.
SENTINEL_DB_URL=jdbc:postgresql://localhost:5433/sentinel
SENTINEL_DB_USERNAME=sentinel
SENTINEL_DB_PASSWORD=change-me

# Host ports for Kafka and Redis, both started by infra/docker-compose.yml.
# Each is one above its usual port, to avoid clashing with one already
# installed; the two settings below must agree with them.
SENTINEL_KAFKA_PORT=9094
SENTINEL_REDIS_PORT=6380

# Where the API publishes reports and reads them back to store (Kafka), and
# where it keeps the seven-day windows (Redis).
SENTINEL_KAFKA_BOOTSTRAP_SERVERS=localhost:9094
SENTINEL_REDIS_URL=redis://localhost:6380

# Where the simulator sends reports.
SENTINEL_API_URL=http://localhost:8080

# The key the API signs access tokens with. At least 32 bytes and random; make
# one with: openssl rand -base64 48
SENTINEL_JWT_SECRET=change-me-to-at-least-32-random-bytes-000000

# Whether the refresh cookie is sent over HTTPS only. Browsers treat localhost
# as secure, so this stays true for local development.
SENTINEL_COOKIE_SECURE=true

# The administrator created on the API's first start, and never overwritten.
# The password must be at least 12 characters.
SENTINEL_ADMIN_EMAIL=admin@example.org
SENTINEL_ADMIN_PASSWORD=change-me-admin-password

# The trusted report feed the simulator submits through (docs/adr/0012). The API
# and the simulator must share it. At least 32 bytes; unset switches the feed off.
SENTINEL_FEED_KEY=change-me-feed-key-at-least-32-bytes-000000
